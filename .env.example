# Modelo de variáveis de ambiente. Copie para um arquivo chamado ".env"
# e preencha quando precisar. O arquivo .env NÃO sobe para o git.

# Chave secreta do Flask (troque por um texto aleatório no futuro).
# SECRET_KEY=um-texto-bem-aleatorio-aqui

# Banco de dados.
# - Deixe em branco/sem esta linha para usar o SQLite local (padrão de hoje).
# - No dia da integração com o cohab-control, aponte para o PostgreSQL:
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/nome_do_banco
#
# Para PostgreSQL, após configurar o DATABASE_URL, crie as tabelas com:
#   flask db upgrade
# (Não precisa rodar db upgrade para SQLite — as tabelas são criadas automaticamente.)
